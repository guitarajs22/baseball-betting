# --- Backtest artifacts (large CSVs, caches, logs) ---
# Keep the Python modules, exclude everything else
backtest/**/*.csv
backtest/**/*.log
backtest/**/*.json
backtest/**/_done
backtest/**/final_report.txt
backtest/**/run_*.txt
backtest/results*.csv
backtest/f5_*.json
backtest/lineup_cache*.json

# --- FanGraphs CSV exports ---
# These ARE committed to the repo so they travel to Railway and the
# /admin/import-fangraphs route can refresh production stats from them.
# To refresh: re-export from FanGraphs into exports/{year}/, git push,
# click "Import FanGraphs Stats" in /settings on the live app.
# (Empty placeholder file kept by the .gitkeep below.)

# --- Deployment artifacts ---
*.bak

# --- NOTE: database/betting.db is intentionally NOT ignored ---
# It ships with the repo as the seed DB. On Railway, the seed is copied once
# into the persistent /data volume; subsequent deploys don't overwrite it.
